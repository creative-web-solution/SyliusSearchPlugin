{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{{ form_start(form, {
        'action': path('monsieurbiz_search_post'),
        'method': 'POST',
        'attr': {
                'class': 'search-form autocomplete-search position-relative',
                'tabindex': '-1',
                'autocomplete': 'off',
                'role': 'search'
        }
}) }}
    {{ form_errors(form) }}

<div class="input-group">
        {{ form_widget(form.query, {
                'value': query,
                'attr': {
                        'class': 'form-control',
                        'placeholder': 'sylius.ui.search'|trans,
                        'aria-label': 'sylius.ui.search'|trans
                }
        }) }}
        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" aria-label="{{ 'sylius.ui.search'|trans }}">
                {{ ux_icon('tabler:search', {class: 'icon icon-sm'}) }}
        </button>
</div>

{{ form_errors(form.query) }}

<div class="autocomplete-results results position-absolute top-100 start-0 w-100 bg-white border rounded-bottom shadow-sm z-3"></div>

    {% do form.submit.setRendered %}
{{ form_end(form) }}