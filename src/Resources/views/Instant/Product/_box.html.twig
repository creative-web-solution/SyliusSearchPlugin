{% import '@SyliusShop/shared/macro/money.html.twig' as money %}

{% set product_url = path('sylius_shop_product_show', {'slug': item.slug, '_locale': sylius.localeCode}) %}

{% if item.images|first %}
    {% set image_path = item.images|first.path|imagine_filter(filter|default('sylius_shop_product_thumbnail')) %}
{% else %}
    {% set image_path = asset('bundles/syliusshop/images/200x200.png') %}
{% endif %}

<div class="result d-flex align-items-center gap-3 p-2 border-bottom">
    <a href="{{ product_url }}" class="flex-shrink-0">
        <img
                src="{{ image_path }}"
                alt="{{ item.name }}"
                class="img-fluid rounded"
                style="width: 64px; height: 64px; object-fit: cover;"
                loading="lazy"
        />
    </a>

    <div class="content flex-grow-1">
        <a href="{{ product_url }}" class="d-block fw-semibold text-decoration-none text-body sylius-product-name">
            {{ item.name }}
        </a>

        {% if item.prices is not empty %}
            {% set pricing = item.prices|filter(price => price.channel_code == sylius.channel.code)|first %}
            {% if pricing %}
                <div class="text-muted small sylius-product-price">
                    {{ money.convertAndFormat(pricing.price) }}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
